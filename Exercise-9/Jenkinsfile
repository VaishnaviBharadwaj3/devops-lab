
pipeline {
    agent any

    stages {
        stage('Build') {
            steps {
                dir('Exercise-9') {
                    echo 'Installing dependencies...'
                    sh '''
                        python3 -m venv .venv
                        .venv/bin/pip install -r requirements.txt
                    '''
                }
            }
        }

        stage('Test') {
            steps {
                dir('Exercise-9') {
                    echo 'Running unit tests...'
                    sh '.venv/bin/python -m unittest discover -s .'
                }
            }
        }

        stage('Deploy') {
            steps {
                dir('Exercise-9') {
                    echo 'Deploying application...'
                    sh '''
                        mkdir -p "${WORKSPACE}/python-app-deploy"
                        cp app.py requirements.txt \
                            "${WORKSPACE}/python-app-deploy/"
                    '''
                }
            }
        }

        stage('Run Application') {
            steps {
                echo 'Starting Flask application...'
                sh '''
                    cd "${WORKSPACE}/python-app-deploy"

                    if [ -f app.pid ]; then
                        kill "$(cat app.pid)" 2>/dev/null || true
                    fi

                    nohup "${WORKSPACE}/Exercise-9/.venv/bin/python" \
                        app.py > app.log 2>&1 &

                    echo $! > app.pid
                    sleep 3
                '''
            }
        }

        stage('Test Application') {
            steps {
                echo 'Testing deployed application over HTTP...'
                sh '''
                    curl --fail --silent --show-error \
                        --retry 5 --retry-connrefused --retry-delay 2 \
                        http://127.0.0.1:5000/
                '''
            }
        }
    }

    post {
        success {
            echo 'Pipeline completed successfully!'
        }
        failure {
            echo 'Pipeline failed. Check the console output.'
        }
    }
}
